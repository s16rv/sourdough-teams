        "prettier": "^3.3.3",
        "prettier-plugin-solidity": "^1.4.1",
        "solidity-coverage": "^0.8.17"
    },
    "dependencies": {
        "@cosmjs/crypto": "^0.32.4",
        "@cosmjs/encoding": "^0.32.4",
        "@openzeppelin/contracts": "^5.4.0",
        "dotenv": "^16.4.5",
        "ethers": "^6.13.3"
